            color: var(--text);
        }

        .subtitle {
            margin-top: 0;
            color: var(--muted);
        }

        .notice {
            margin: 25px 0;
            padding: 16px 20px;

            background: rgba(88, 166, 255, 0.08);

            border-left: 4px solid var(--accent);
            border-radius: 6px;
        }

        a {
            color: var(--accent);
            text-decoration: none;
        }

        a:hover {
            text-decoration: underline;
        }

        footer {
            margin-top: 40px;
            padding-top: 20px;

