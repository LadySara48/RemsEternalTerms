            margin: 0 auto;
            padding: 40px;

            background: var(--container);

            border: 1px solid var(--border);
            border-radius: 12px;
        }

        h1 {
            margin-top: 0;
            margin-bottom: 5px;

            font-size: 2rem;
        }

        h2 {
            margin-top: 35px;

            padding-bottom: 8px;

            border-bottom: 1px solid var(--border);

            font-size: 1.25rem;
